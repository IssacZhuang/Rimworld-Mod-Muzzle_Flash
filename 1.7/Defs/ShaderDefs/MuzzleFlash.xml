<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <!-- 1.7 (Waylith): 由引擎从 1.7/Shaders 加载 GLSL 源码并编译,
       取代 1.4-1.6 的 Unity AssetBundle 预编译 shader -->
  <ShaderDef>
    <defName>MuzzleFlashAnimatedAdditive</defName>
    <shaderProgram>
      <vertexShaderFileName>MuzzleFlash.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MuzzleFlash.frag.glsl</fragmentShaderFileName>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <renderQueue>3151</renderQueue>
    </shaderProgram>
  </ShaderDef>

  <!-- DevMode 诊断用: 品红测试块, 用于验证绘制管线与 SSBO 数据链路 -->
  <ShaderDef>
    <defName>MuzzleFlashDebugSolid</defName>
    <shaderProgram>
      <vertexShaderFileName>MuzzleFlash.vert.glsl</vertexShaderFileName>
      <fragmentShaderFileName>MuzzleFlashDebug.frag.glsl</fragmentShaderFileName>
      <blendMode>Additive</blendMode>
      <depthWrite>false</depthWrite>
      <renderQueue>3151</renderQueue>
    </shaderProgram>
  </ShaderDef>

</Defs>
